# GEMINI_API_KEY: Required for Gemini AI Assistant server-side calls.
GEMINI_API_KEY=

# Application configuration
APP_NAME="UPRSA Official State Portal"
APP_ENV=production
APP_URL=

# Database Configuration (MySQL 8+ / Hostinger)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uprsa_db
DB_USERNAME=root
DB_PASSWORD=

# Email Configuration (Resend - Server-side only)
RESEND_API_KEY=
EMAIL_FROM="UPRSA Federation <notifications@uprsa.org>"

# File Storage Configuration
STORAGE_PATH="./storage"
JWT_SECRET=uprsa_state_portal_secure_jwt_secret_key_2026
